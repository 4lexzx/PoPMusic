{
  "name": "popmusic-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:electron": "vite --host 127.0.0.1",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ytdlp-nodejs": "^3.4.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "electron": "^45.4.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.popmusic.client",
    "productName": "PoP Music Client",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ytdlp-nodejs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "PoP Music Client Setup-${version}.${ext}"
    }
  },
  "description": "Reproductor de música PoP Music (cliente limpio)",
  "author": {
    "name": "4lexzx"
  }
}
