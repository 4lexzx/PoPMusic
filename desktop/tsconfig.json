{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mingcute/react": ["./src/shared/ui/PopIcons.tsx"],
      "@solar-icons/react": ["./src/shared/ui/PopIcons.tsx"],
      "react-icons/lu": ["./src/shared/ui/PopIcons.tsx"],
      "react-icons/fa": ["./src/shared/ui/PopIcons.tsx"]
    }
  },
  "include": [
    "src",
    "electron",
    "vite.config.ts",
    "vite.csp.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
