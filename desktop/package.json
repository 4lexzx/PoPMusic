{
  "name": "pop-music-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PoP Music para Windows",
  "author": "4lexzx",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "electron .",
    "wasm": "node scripts/build-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "dist": "node scripts/build-wasm.mjs && npm run build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.popmusic.desktop",
    "productName": "PoP Music",
    "executableName": "PoP Music",
    "artifactName": "PoP Music Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icons/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PoP Music"
    },
    "protocols": [
      {
        "name": "PoP Music",
        "schemes": [
          "popmusic"
        ]
      }
    ]
  },
  "dependencies": {
    "@mingcute/react": "^3.1.0",
    "@solar-icons/react": "^2.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "bgutils-js": "^4.0.3",
    "framer-motion": "^12.23.12",
    "lucide-react": "^1.77.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
