# Claves de PoP Music (React Native / Expo)
# Copia este archivo a `.env` y rellena los valores. Las variables con prefijo
# EXPO_PUBLIC_ se incrustan en el bundle de la app.
#
# IMPORTANTE: la búsqueda, la reproducción (canciones completas de YouTube) y la
# importación de playlists funcionan SIN ninguna clave. Estas variables solo
# amplían funciones opcionales.

# AudD (reconocimiento de música). Sin ella la pantalla «Reconocer» queda inactiva.
EXPO_PUBLIC_AUDD_API_KEY=

# Base de un backend propio (opcional). Sirve para:
#  - la función de Spotify (SPOTIFY_API_PATH = ${EXPO_PUBLIC_API_BASE_URL}/api/spotify)
#  - un endpoint de streaming propio (${EXPO_PUBLIC_API_BASE_URL}/api/stream?videoId=...)
EXPO_PUBLIC_API_BASE_URL=
