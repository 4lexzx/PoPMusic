# ============================================================================
#  Variables de entorno — copia este archivo como ".env" y rellena tus claves
# ============================================================================

# YouTube Data API v3 (búsqueda e importación de playlists).
# Se expone al navegador porque la Data API está diseñada para uso client-side.
# Consola: https://console.cloud.google.com/apis/credentials
VITE_YT_API_KEY=

# Spotify Web API — Client ID (se puede exponer, se usa solo como identificador).
# Dashboard: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Spotify Web API — Client Secret.
# IMPORTANTE: SIN el prefijo VITE_ a propósito. Solo lo lee la Serverless
# Function en /api/spotify (servidor). Nunca llega al navegador.
SPOTIFY_CLIENT_SECRET=

# AudD — token para reconocer música con el micrófono (función "Reconocer").
# Regístrate gratis en https://dashboard.audd.io/ y copia tu API token.
VITE_AUDD_API_KEY=

# Backend de audio propio (extrae el audio de YouTube con yt-dlp).
# Si se configura, las canciones suenan en segundo plano y en la pantalla de
# bloqueo. URL base SIN barra final. Ver la carpeta backend/.
VITE_AUDIO_API=
